# OS / editor cruft
.DS_Store
*.swp
Thumbs.db

# 构建与运行产物
# 只钉仓库根的 dist/（make build 的输出）。不能写成裸 `dist/`：那会在任意层级
# 匹配，连 hub/internal/site/dist/ 一并排除，而被排除目录里的文件无法再用 `!`
# 捞回来——占位 index.html 就进不了库，新克隆出来的仓库 //go:embed all:dist 直接编译失败。
/dist/
pb_data/
node_modules/
*.pem

# 前端构建产物不入库，但保留占位 index.html，否则 //go:embed all:dist 找不到目录
hub/internal/site/dist/*
!hub/internal/site/dist/index.html

# lingui compile 的产物。运行时直接 import .po（见 src/i18n/index.ts），
# 这些 .js 没人用，入库只会和 .po 打架。
hub/internal/site/src/locales/*.js

# git worktrees
.worktrees/
